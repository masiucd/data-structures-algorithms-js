{
  "name": "@dsajs/monorepo",
  "exports": "./index.js",
  "workspace": [
    "./lib"
  ],
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@/lib/": "./lib/"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ],
      "exclude": [
        "prefer-const"
      ]
    }
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 80,
    "semiColons": true,
    "options": {
      "singleQuote": false,
      "lineWidth": 90,
      "semiColons": true,
      "proseWrap": "always",
      "useTabs": false
    },
    "singleQuote": false,
    "indentWidth": 2,
    "exclude": [
      "node_modules",
      "dist",
      "build"
    ]
  }
}